{
  "name": "face-api.js",
  "version": "0.22.2",
  "description": "JavaScript API for face detection and face recognition in the browser with tensorflow.js",
  "type": "module",
  "module": "./build/es6/index.js",
  "main": "./build/commonjs/index.js",
  "typings": "./build/commonjs/index.d.ts",
  "scripts": {
    "rollup-min": "rollup -c rollup.config.mjs --environment minify:true",
    "rollup": "rollup -c rollup.config.mjs",
    "tsc": "tsc",
    "tsc-es6": "tsc --p tsconfig.es6.json",
    "build": "rm -rf ./build && rm -rf ./dist && npm run rollup && npm run rollup-min && npm run tsc && npm run tsc-es6 && node add-js-extensions.js",
    "build-test-esm": "tsc --p tsconfig.test-esm.json && node add-js-extensions-test.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:node": "jest --testEnvironment=node",
    "test:browser": "jest --testEnvironment=jsdom",
    "docs": "typedoc --options ./typedoc.config.js ./src"
  },
  "keywords": [
    "face",
    "detection",
    "recognition",
    "tensorflow",
    "tf"
  ],
  "author": "justadudewhohacks",
  "license": "MIT",
  "dependencies": {
    "@tensorflow/tfjs-core": "^4.22.0",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.5",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.5",
    "canvas": "^2.11.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.1.0",
    "rollup": "^4.9.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
